---
// src/components/Footer.astro
---

<footer class="w-full bg-white pb-12 px-4 md:px-8 flex justify-center">
  <div
    class="w-full max-w-360 bg-[#00413E] rounded-3xl overflow-hidden text-white flex flex-col justify-between min-h-[400px]"
  >
    <div
      class="p-15 pt-5 lg:pt-12 lg:px-30 flex flex-col justify-between grow gap-4"
    >
      <!-- Mobile Arrow -->
      <div class="flex justify-end md:hidden lg:col-span-3 lg:justify-self-end">
        <button
          onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
          class="text-white/80 hover:text-[#2DD4BF] transition-colors"
          aria-label="Back to top"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-5">
        <!-- Buzzrefer -->
        <div class="lg:col-span-6">
          <div class="flex items-center justify-center md:justify-start gap-3">
            <img
              src="/buzzrefer.svg"
              class="h-12 md:h-10 w-auto"
              alt="BuzzRefer Logo"
            />
            <span
              class="font-montserrat text-3xl font-normal tracking-tight text-white"
            >
              <strong>buzz</strong>refer.
            </span>
          </div>
        </div>

        <!-- Mobile Nav -->
        <div
          class="flex md:hidden lg:col-span-6 flex-wrap justify-center gap-8 text-sm text-white/80"
        >
          <a href="/" class="hover:text-[#2DD4BF] transition-colors">Home</a>
          <a href="/how-it-works" class="hover:text-[#2DD4BF] transition-colors"
            >How It Works</a
          >
          <a href="/contact" class="hover:text-[#2DD4BF] transition-colors"
            >Contact</a
          >
        </div>

        <div class="lg:col-span-3">
          <h4
            class="text-xs md:text-white/60 mb-2 md:mb-6 font-bold md:font-medium md:tracking-widest md:uppercase"
          >
            Contact us
          </h4>
          <div
            class="flex flex-col gap-3 text-sm md:text-base font-normal text-white/80"
          >
            <p>+1 891 989-11-91</p>
            <p>hello@logoipsum.com</p>
          </div>
        </div>

        <div
          class="lg:col-span-3 lg:justify-self-end text-left w-full lg:w-auto"
        >
          <h4
            class="text-xs md:text-white/60 mb-2 md:mb-6 font-bold md:font-medium md:tracking-widest md:uppercase"
          >
            Follow us
          </h4>
          <div
            class="flex flex-col gap-3 text-sm md:text-base font-normal text-white/80"
          >
            <a href="#" class="hover:text-[#2DD4BF] transition-colors"
              >Whatsapp</a
            >
            <a href="#" class="hover:text-[#2DD4BF] transition-colors"
              >Instagram</a
            >
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-y-8 items-end mt-auto">
        <div
          class="hidden md:flex lg:col-span-6 flex-wrap gap-8 text-sm font-medium text-white/80"
        >
          <a href="/" class="hover:text-[#2DD4BF] transition-colors">Home</a>
          <a href="/how-it-works" class="hover:text-[#2DD4BF] transition-colors"
            >How It Works</a
          >
          <a href="/contact" class="hover:text-[#2DD4BF] transition-colors"
            >Contact</a
          >
        </div>

        <div
          class="lg:col-span-3 text-white font-bold md:text-white/60 text-sm md:font-normal"
        >
          Phoenix, Arizona, USA.
        </div>
        <!-- Arrow Button -->
        <div class="hidden md:block lg:col-span-3 lg:justify-self-end">
          <button
            onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
            class="text-white/80 hover:text-[#2DD4BF] transition-colors cursor-pointer"
            aria-label="Back to top"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <!-- Copy -->
    <div
      class="bg-[#00B89F] pt-2 pb-4 md:py-5 px-6 lg:px-24 grid grid-cols-7 md:grid-cols-3 gap-x-4 gap-y-2 md:gap-4 items-center text-[#00382e] text-sm font-semibold"
    >
      <p
        class="text-center font-extrabold col-span-7 md:col-span-1 md:text-left"
      >
        © 2025 — Copyright
      </p>

      <div
        class="flex justify-end md:justify-center col-span-3 md:col-span-1 font-bold"
      >
        <a href="#" class="hover:underline">Privacy</a>
      </div>

      <p
        class="flex justify-start md:justify-end col-span-4 md:col-span-1 font-bold"
      >
        All rights reserved
      </p>
    </div>
  </div>
</footer>
