---
import { Image } from "astro:assets";
import savingMoney from "@/assets/saving-money-illustration-man.svg";
import plantingTree from "@/assets/planting-tree-illustration.svg";
import twoCoins from "@/assets/two-coins-illustration.svg";
---

<section class="max-w-screen mx-auto pt-12 pb-124 md:py-24 space-y-24">
  <div
    class="flex flex-col lg:flex-row items-center gap-12 md:my-40 md:px-32 mt-20 mb-40"
  >
    <div class="w-xs md:w-[40%] flex justify-center md:justify-start">
      <Image
        src={savingMoney}
        alt="Saving Money Man Illustration"
        class="w-full max-w-md h-auto object-contain -scale-x-100"
      />
    </div>

    <div class="w-full lg:w-[60%] text-center lg:text-left">
      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-bold text-[#0d3b36] mb-6 leading-tight tracking-tight"
      >
        How Our Three-Tier Referral System Works
      </h1>

      <p
        class="text-gray-600 text-md md:text-xl mb-4 md:mb-10 leading-relaxed max-w-[650px] mx-auto lg:mx-0 px-4"
      >
        BuzzRefer uses a multi-tier referral structure that rewards you not only
        for direct referrals, but also for the people they invite.
      </p>

      <div>
        <button
          class="bg-[#00CCAA] text-[#00382e] px-8 py-4 rounded-lg font-bold text-base hover:bg-[#00bfa0] transition-colors shadow-sm"
        >
          Learn More
        </button>
      </div>
    </div>
  </div>

  <div class="bg-[#EAF8F4] w-full py-24 px-6 md:px-12">
    <div
      class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
    >
      <div class="lg:col-span-4">
        <h2
          class="text-5xl md:text-6xl font-bold text-[#0d3b36] leading-tight flex justify-center md:justify-start text-center md:text-left"
        >
          Our System <br /> Explained
        </h2>
      </div>

      <div
        class="lg:col-span-8 relative min-h-[550px] flex items-center justify-center lg:block"
      >
        <div
          class="flex flex-col items-center justify-center gap-10 lg:block lg:relative lg:h-[550px] w-full"
        >
          <!-- Tier 2 Mobile-->
          <div
            class="block md:hidden bg-white p-4 rounded-2xl relative w-[230px] lg:absolute lg:bottom-10 lg:left-45 z-20"
          >
            <div class="absolute -right-5 -top-5 w-28 h-20 z-20">
              <Image
                src={twoCoins}
                alt="Coins"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="relative z-10">
              <span
                class="text-sm font-bold text-[#0d3b36]/80 mb-2 block uppercase tracking-wider"
                >Tier 2</span
              >
              <h3 class="text-2xl font-bold text-[#0d3b36] mb-4 leading-tight">
                Their Referrals
              </h3>
              <p class="text-[#0d3b36] text-sm">
                When your referrals invite new people, you still earn from
                them—automatically.
              </p>
            </div>
          </div>
          <!-- Tier 3 Mobile-->
          <div
            class="block md:hidden bg-white p-4 rounded-2xl relative w-[310px] lg:absolute lg:top-1/2 lg:-translate-y-1/2 lg:right-0 z-30"
          >
            <div class="absolute -right-6 -top-10 w-28 h-24 z-20">
              <Image
                src={twoCoins}
                alt="Coins"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="relative z-10">
              <span
                class="text-sm font-bold text-[#0d3b36]/80 mb-2 block uppercase tracking-wider"
                >Tier 3</span
              >
              <h3 class="text-2xl font-bold text-[#0d3b36] mb-3 leading-tight">
                Neighborhood Growth
              </h3>
              <p class="text-[#0d3b36] text-sm lg:w-[220px]">
                As your whole area builds up, service density increases,
                lowering the base rate for everyone in your zone.
              </p>
            </div>
          </div>
          <!-- Tier 1 -->
          <div
            class="bg-white p-6 pr-4 rounded-2xl relative w-[280px] lg:h-43 lg:absolute lg:top-20 lg:left-35 z-20"
          >
            <div class="absolute -right-5 -top-10 w-28 h-20 z-20">
              <Image
                src={twoCoins}
                alt="Coins"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="relative z-10">
              <span
                class="text-sm font-bold text-[#0d3b36]/80 mb-2 block uppercase tracking-wider"
                >Tier 1</span
              >
              <h3 class="text-2xl font-bold text-[#0d3b36] mb-4 leading-tight">
                Your Direct Referrals
              </h3>

              <p class="text-[#0d3b36] text-sm max-w-[200px]">
                When your referrals invite new people, you still earn from
                them—automatically.
              </p>
            </div>
          </div>
          <!-- Tier 2 -->
          <div
            class="hidden md:block bg-white p-4 rounded-2xl relative w-[230px] lg:absolute lg:bottom-10 lg:left-45 z-20"
          >
            <div class="absolute -right-5 -top-5 w-28 h-20 z-20">
              <Image
                src={twoCoins}
                alt="Coins"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="relative z-10">
              <span
                class="text-sm font-bold text-[#0d3b36]/80 mb-2 block uppercase tracking-wider"
                >Tier 2</span
              >
              <h3 class="text-2xl font-bold text-[#0d3b36] mb-4 leading-tight">
                Their Referrals
              </h3>
              <p class="text-[#0d3b36] text-sm">
                When your referrals invite new people, you still earn from
                them—automatically.
              </p>
            </div>
          </div>
          <!-- Tier 3 -->
          <div
            class="hidden md:block bg-white p-4 rounded-2xl relative w-[310px] lg:absolute lg:top-1/2 lg:-translate-y-1/2 lg:right-0 z-30"
          >
            <div class="absolute -right-6 -top-10 w-28 h-24 z-20">
              <Image
                src={twoCoins}
                alt="Coins"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="relative z-10">
              <span
                class="text-sm font-bold text-[#0d3b36]/80 mb-2 block uppercase tracking-wider"
                >Tier 3</span
              >
              <h3 class="text-2xl font-bold text-[#0d3b36] mb-3 leading-tight">
                Neighborhood Growth
              </h3>
              <p class="text-[#0d3b36] text-sm lg:w-[220px]">
                As your whole area builds up, service density increases,
                lowering the base rate for everyone in your zone.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="px-6 py-36 md:px-12 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-5 gap-12 lg:gap-24 items-center">
      <div class="flex justify-center lg:justify-start md:col-span-2">
        <Image
          src={plantingTree}
          alt="Why this matters illustration"
          class="w-full max-w-md h-auto object-contain"
        />
      </div>

      <div class="text-left w-full md:col-span-3">
        <h2
          class="text-4xl md:text-5xl justify-center text-center md:text-left md:justify-start lg:text-6xl font-bold text-[#0d3b36] mb-6 leading-tight"
        >
          Why this change <br /> matters?
        </h2>

        <p
          class="text-black text-center justify=center md:text-left md:justify-start md:text-gray-600 text-lg mb-10 leading-relaxed max-w-xl"
        >
          Connects you with trusted providers who save more in high-density
          areas — and share those savings with you.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 w-full mb-10">
          <div
            class="bg-[#F0FDF9] border border-[#2DD4BF] px-5 py-4 rounded-2xl flex items-center shadow-sm h-full"
          >
            <p
              class="text-[#0d3b36] font-semibold text-lg leading-tight text-left"
            >
              You earn recurring rewards
            </p>
          </div>

          <div
            class="bg-[#F0FDF9] border border-[#2DD4BF] px-5 py-4 rounded-2xl flex items-center shadow-sm h-full"
          >
            <p
              class="text-[#0d3b36] font-semibold text-lg leading-tight text-left"
            >
              Costs decrease for the whole neighborhood
            </p>
          </div>

          <div
            class="bg-[#F0FDF9] border border-[#2DD4BF] px-5 py-4 rounded-2xl flex items-center shadow-sm h-full"
          >
            <p
              class="text-[#0d3b36] font-semibold text-lg leading-tight text-left"
            >
              Providers operate more efficiently
            </p>
          </div>
        </div>

        <div>
          <button
            class="mx-auto bg-[#00CCAA] text-[#00382e] px-8 py-4 rounded-lg font-bold text-base hover:bg-[#00bfa0] transition-colors shadow-md flex justify-center md:justify-start items-center gap-2"
          >
            Sign Up
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
