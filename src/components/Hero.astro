---
import { Image } from "astro:assets";
import ArrowRightIcon from "@/components/icons/ArrowRight.astro";
import coinsIllustration from "@/assets/coins-illustration.svg";
import womanJarIllustration from "@/assets/woman-jar-illustration.svg";
---

<section
  class="relative w-full min-h-150 md:min-h-screen flex flex-col items-start md:items-center justify-start md:justify-center overflow-hidden bg-white"
>
  <div class="relative z-20 text-center max-w-7xl px-8 pt-25 md:pt-28 pb-20">
    <h1
      class="text-5xl md:text-7xl hidden md:block font-bold text-[#0d3b36] leading-[1.1] mb-8 tracking-tight"
    >
      Your Community. <br />
      <span class="font-normal">Better Prices.</span>Monthly Rewards.
    </h1>

    <h2
      class="block md:hidden items-start mt-15 mb-4 text-2xl font-bold leading-relaxed"
    >
      Join Us & Start Earning Discounts with Every Referral
    </h2>

    <p class="block md:hidden text-sm mb-6">
      Lorem ipsum dolor sit amet consectetur adipiscing eli mattis sit phasellus
      mollis sit nullam neque ultrices.
    </p>

    <p
      class="hidden md:block text-gray-600 text-md font-bold md:text-xl leading-relaxed mb-12 max-w-2xl mx-auto"
    >
      BuzzRefer helps you save by boosting service density in your neighborhood
      invite others and earn monthly credits automatically.
    </p>

    <a
      href="https://buzzrefer.club/app/signup"
      class="bg-[#00CCAA] hover:bg-[#00bfa0] text-[#00382e] font-bold text-lg px-10 py-4 rounded-lg transition-all inline-flex items-center gap-3 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
    >
      Get Started
      <ArrowRightIcon class="w-6 h-6" />
    </a>
  </div>

  <div
    class="absolute bottom-0 md:bottom-5 md:left-0 z-10 max-w-full w-md lg:max-w-[650px] xl:w-[50%]"
  >
    <Image
      src={coinsIllustration}
      alt="Coins Pile"
      class="w-full h-auto object-contain object-bottom transform translate-y-4"
    />
  </div>

  <div
    class="hidden lg:block absolute bottom-0 right-0 z-10 w-[28%] max-w-[900px] xl:w-[50%]"
  >
    <Image
      src={womanJarIllustration}
      alt="Woman saving money"
      class="w-full h-auto object-contain object-bottom"
    />
  </div>
</section>
