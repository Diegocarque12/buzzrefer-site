{
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "https://buzzrefer.vercel.app/app/"
    },
    {
      "source": "/app/",
      "destination": "https://buzzrefer.vercel.app/app/"
    },
    {
      "source": "/app/:match*",
      "destination": "https://buzzrefer.vercel.app/app/:match*"
    }
  ]
}
