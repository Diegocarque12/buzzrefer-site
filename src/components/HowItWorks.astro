---
import { Image } from "astro:assets";
import lightCoinsIllustration from "@/assets/light-coins-illustration.svg";

const steps = [
  {
    number: "1",
    title: "Sign up",
    description:
      "Lorem ipsum dolor sit amet consectetur adipiscing elit mattis sit phasellus mollis sit",
  },
  {
    number: "2",
    title: "Customer Refer",
    description:
      "Lorem ipsum dolor sit amet consectetur adipiscing elit mattis sit phasellus mollis sit",
  },
  {
    number: "3",
    title: "Everyone Wins",
    description:
      "Lorem ipsum dolor sit amet consectetur adipiscing elit mattis sit phasellus mollis sit",
  },
];
---

<section class="relative w-full bg-white z-10 mt-40 md:mt-0">
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-5xl z-0 flex justify-center pointer-events-none"
  >
    <Image
      src={lightCoinsIllustration}
      alt="Coins Background"
      class="w-[400px] md:w-[700px] h-auto object-contain opacity-100 mt-5"
    />
  </div>

  <div
    class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 pt-32 md:pt-48 pb-16"
  >
    <div class="text-center mb-12">
      <p class="text-xl text-gray-600 font-bold mb-4 md:mb-2">Learn more</p>
      <h2 class="text-5xl md:text-6xl font-bold text-[#0d3b36] mb-4">
        How You Earn
      </h2>
      <p class="text-gray-600 font-bold">
        Learn More About the Referral System
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-20">
      {
        steps.map((step) => (
          <div class="bg-white border border-[#2DD4BF] rounded-2xl p-4 pr-2 flex flex-row items-center gap-4 shadow-sm hover:shadow-md transition-shadow h-full">
            <div class="shrink-0 w-18 h-18 md:w-14 md:h-14 bg-[#00CCAA] rounded-full flex items-center justify-center text-[#00382e] font-bold text-3xl md:text-2xl shadow-sm">
              {step.number}
            </div>
            <div class="text-left w-full">
              <h3 class="font-bold text-[#0d3b36] text-2xl md:text-xl mb-1">
                {step.title}
              </h3>
              <p class="text-[#0d3b36]/90 text-md md:text-sm max-w-none">
                {step.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
