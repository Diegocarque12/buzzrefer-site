---

---

<section
  class="w-full bg-white pt-24 pb-40 md:py-32 px-4 md:px-8 flex justify-center"
>
  <div
    class="w-full max-w-360 bg-[#C8EFE9] border border-[#0d3b36] rounded-3xl p-10 md:p-16 lg:p-20 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-32"
  >
    <div class="flex flex-col justify-center gap-8 h-full">
      <div>
        <p
          class="text-md font-bold text-[#0d3b36] uppercase tracking-widest mb-2"
        >
          Contact Us
        </p>
        <h2
          class="text-4xl md:text-5xl font-bold text-[#0d3b36] mb-4 leading-tight"
        >
          Get in touch today
        </h2>
        <p class="text-[#0d3b36] text-base max-w-md leading-relaxed">
          Lorem ipsum dolor sit amet consectetur adipiscing elit nulla
          adipiscing tincidunt interdum tellus du.
        </p>
      </div>

      <div class="space-y-5">
        <div class="flex items-center gap-4 text-[#0d3b36]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path></svg
          >
          <span class="text-base font-medium">contact@company.com</span>
        </div>

        <div class="flex items-center gap-4 text-[#0d3b36]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
            ></path></svg
          >
          <span class="text-base font-medium">(123) 456 - 789</span>
        </div>

        <div class="flex items-start gap-4 text-[#0d3b36]">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 mt-1 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
          >
          <div class="text-base font-medium">
            <p>794 Mcallister St</p>
            <p>San Francisco, 94102</p>
          </div>
        </div>
      </div>
    </div>

    <form class="space-y-10 w-full pt-2 flex flex-col justify-center">
      <div class="space-y-2 relative group">
        <label class="text-sm font-bold text-[#0d3b36]">Full Name*</label>
        <input
          type="text"
          placeholder="Abigail Rojas"
          class="w-full bg-transparent border-b border-[#0d3b36]/40 py-3 text-[#0d3b36] placeholder-[#0d3b36]/60 focus:outline-none focus:border-[#0d3b36] transition-all text-lg"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div class="space-y-2">
          <label class="text-sm font-bold text-[#0d3b36]">Email*</label>
          <input
            type="email"
            placeholder="Enter your email address"
            class="w-full bg-transparent border-b border-[#0d3b36]/40 py-3 text-[#0d3b36] placeholder-[#0d3b36]/60 focus:outline-none focus:border-[#0d3b36] transition-all text-lg"
          />
        </div>
        <div class="space-y-2">
          <label class="text-sm font-bold text-[#0d3b36]">Subject</label>
          <input
            type="text"
            placeholder="Enter the Subject"
            class="w-full bg-transparent border-b border-[#0d3b36]/40 py-3 text-[#0d3b36] placeholder-[#0d3b36]/60 focus:outline-none focus:border-[#0d3b36] transition-all text-lg"
          />
        </div>
      </div>

      <div class="space-y-2">
        <label class="text-sm font-bold text-[#0d3b36]">Number</label>
        <input
          type="tel"
          placeholder="(123) 456 - 789"
          class="w-full bg-transparent border-b border-[#0d3b36]/40 py-3 text-[#0d3b36] placeholder-[#0d3b36]/60 focus:outline-none focus:border-[#0d3b36] transition-all text-lg"
        />
      </div>

      <div class="space-y-2">
        <label class="text-sm font-bold text-[#0d3b36]">Message*</label>
        <textarea
          rows="1"
          placeholder="Please type your message here..."
          class="w-full bg-transparent border-b border-[#0d3b36]/40 py-3 text-[#0d3b36] placeholder-[#0d3b36]/60 focus:outline-none focus:border-[#0d3b36] transition-all text-lg resize-none overflow-hidden h-auto"
          oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"
        ></textarea>
      </div>

      <div class="pt-6">
        <button
          type="button"
          class="bg-[#10433E] hover:bg-[#0d3b36] text-white font-bold py-3.5 px-8 rounded-lg flex items-center gap-2 transition-all shadow-lg transform hover:-translate-y-0.5"
        >
          Submit
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</section>
