---
const faqs = [
  {
    question: "What is BuzzRefer?",
    answer: "BuzzRefer is a referral platform that helps communities save money by boosting service density."
  },
  {
    question: "How do I sign up?",
    answer: "You can sign up by clicking the 'Get Started' button in the menu and filling out the registration form."
  },
  {
    question: "How much can I save with referrals?",
    answer: "Savings depend on the number of active referrals in your neighborhood. The more density, the lower the price."
  },
  {
    question: "Why do prices drop when more people join?",
    answer: "Service providers save on logistics and travel time when customers are clustered, passing those savings to you."
  },
  {
    question: "Can I track my referral earnings?",
    answer: "Yes, our dashboard provides real-time tracking of all your referrals and accumulated credits."
  }
];
---

<section class="max-w-7xl mx-auto px-6 md:px-12 py-12 md:py-24 bg-white">

  <div class="grid lg:grid-cols-12 gap-12 lg:gap-24 items-center">
    
    <div class="lg:col-span-5">
      <span class="bg-[#00CCAA] text-[#00382e] text-xs font-extrabold px-3 py-1 rounded-full md:tracking-widest inline-block mb-6">
        Support
      </span>
      
      <h2 class="text-6xl md:text-6xl font-medium leading-[1.15] mb-6">
        Frequently <br />
        Asked <br />
        <span class="font-bold">Questions</span>
      </h2>
      
      <p class="text-gray-500 text-base leading-relaxed">
        Need quick information? <br />
        Browse our FAQ for concise answers to the most common questions.
      </p>
    </div>

    <div class="lg:col-span-7 flex flex-col gap-3">
      {faqs.map((faq) => (
        <details class="group bg-[#D1F0EA] border border-[#2DD4BF] rounded-xl overflow-hidden transition-all duration-300 open:shadow-md cursor-pointer">
          <summary class="flex justify-between items-center p-4 list-none font-semibold text-[#0d3b36] text-base select-none">
            {faq.question}
            <!-- Icono Flecha -->
            <span class="transition-transform duration-300 group-open:rotate-180 shrink-0 ml-4">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#004d40]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          
          <div class="px-4 pb-4 text-[#004d40] text-sm leading-relaxed opacity-90">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>