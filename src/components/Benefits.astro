---
import Image from "astro/components/Image.astro";
const benefits = [
  {
    title: "Lower Prices in Your Area",
    description:
      "Our members provide special prices and deals to our referral.",
    icon: "🏷️",
  },
  {
    title: "Earn Monthly Rewards",
    description: "You get rewarded for every new person you refer to our site.",
    icon: "💰",
  },
  {
    title: "Faster & More Reliable Service",
    description: "The best way to get service you love from your local vendor.",
    icon: "⚡",
  },
  {
    title: "Track Your Savings",
    description: "See exactly how much you have saved and earned.",
    icon: "🐷",
  },
];

const illustration = import("@/assets/small-town-illustration.svg");
---

<section class="max-w-7xl mx-auto px-6 md:px-12 py-12 md:py-24 bg-green-200">
  <div class="flex flex-col md:flex-row items-center gap-16">
    <!-- Left: Illustration -->
    <div class="flex-1 w-full max-w-md">
      <div
        class="aspect-square bg-transparent flex items-center justify-center relative"
      >
        <Image src={illustration} alt="Illustration" />
      </div>

      <div class="mt-8">
        <h2 class="h2 md:text-5xl font-bold text-teal-900 leading-tight mb-4">
          Benefits <br /> You'll Love
        </h2>
        <p class="text-gray-900 max-w-sm text-lg line-height-150">
          Here’s how <strong>BuzzRefer</strong> makes your service experience easier,
          more affordable, <strong>and rewarding from day one</strong>.
        </p>
      </div>
    </div>

    <!-- Right: Benefits List -->
    <div class="flex-1 space-y-8 w-full max-w-lg">
      {
        benefits.map((benefit) => (
          <div class="flex gap-6">
            <div class="flex-shrink-0 w-12 h-12 bg-teal-500 rounded-xl flex items-center justify-center text-white text-2xl shadow-lg shadow-teal-100">
              {benefit.icon}
            </div>
            <div>
              <h3 class="font-bold text-teal-900 text-lg mb-1">
                {benefit.title}
              </h3>
              <p class="text-gray-500 text-sm leading-relaxed">
                {benefit.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
