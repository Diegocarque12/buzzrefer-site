---

---

<section class="max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-24 space-y-24">
    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto">
        <!-- Illustration Placeholder -->
        <div class="mb-8 flex justify-center">
            <!-- Replicating the "Savings Jar" concept with SVGs or a placeholder div -->
            <div class="relative w-64 h-64 md:w-80 md:h-80">
                <svg
                    viewBox="0 0 200 200"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-full h-full text-teal-600"
                >
                    <!-- Abstract representation of the illustration -->
                    <circle cx="100" cy="100" r="90" fill="#E6FFFA"></circle>
                    <path
                        d="M70 140 L130 140 L130 80 L70 80 Z"
                        fill="#38B2AC"
                        opacity="0.2"></path>
                    <!-- Jar shape -->
                    <circle cx="100" cy="90" r="15" fill="#319795"></circle>
                    <!-- Coin -->
                    <circle cx="80" cy="70" r="10" fill="#38B2AC"></circle>
                    <!-- Coin -->
                    <circle cx="120" cy="75" r="10" fill="#38B2AC"></circle>
                    <!-- Coin -->
                    <!-- Person placeholder -->
                    <circle cx="50" cy="100" r="20" fill="#2C7A7B"></circle>
                    <rect
                        x="30"
                        y="125"
                        width="40"
                        height="60"
                        rx="10"
                        fill="#234E52"></rect>
                </svg>
            </div>
        </div>

        <h1
            class="text-3xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight"
        >
            How Our Three-Tier Referral System Works
        </h1>
        <p class="text-gray-600 text-lg md:text-xl mb-8 leading-relaxed">
            BuzzRefer turns every client into a fund-raiser for their
            neighborhood. Referral bonuses flow directions for complete
            efficiency.
        </p>
        <button
            class="bg-teal-500 text-white px-8 py-3 rounded-full font-semibold hover:bg-teal-600 transition-colors shadow-lg shadow-teal-200"
        >
            Learn More
        </button>
    </div>

    <!-- System Explained Section -->
    <div class="bg-teal-50/50 rounded-3xl p-8 md:p-16 relative overflow-hidden">
        <div class="text-center mb-16 relative z-10">
            <h2 class="text-3xl md:text-4xl font-bold text-teal-900">
                Our System Explained
            </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-12 items-center relative z-10">
            <!-- Steps -->
            <div class="space-y-6">
                <!-- Tier 3 -->
                <div
                    class="bg-white p-6 rounded-2xl shadow-sm border border-teal-100 flex gap-4 items-start relative overflow-hidden group hover:shadow-md transition-shadow"
                >
                    <div
                        class="absolute right-0 top-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity"
                    >
                        <svg
                            class="w-16 h-16 text-teal-500"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                            ><path
                                d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 11H9v2h2v-2zm0-8H9v6h2V5z"
                            ></path></svg
                        >
                    </div>
                    <div class="flex-1">
                        <span
                            class="text-xs font-bold text-teal-500 uppercase tracking-widest mb-1 block"
                            >Tier 3</span
                        >
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Their Referrals
                        </h3>
                        <p class="text-gray-600 text-sm">
                            When provided references by your passenger, earnings
                            flow back to your community.
                        </p>
                    </div>
                </div>

                <!-- Tier 2 -->
                <div
                    class="bg-white p-6 rounded-2xl shadow-sm border border-teal-100 flex gap-4 items-start relative overflow-hidden group hover:shadow-md transition-shadow"
                >
                    <div class="flex-1">
                        <span
                            class="text-xs font-bold text-teal-500 uppercase tracking-widest mb-1 block"
                            >Tier 2</span
                        >
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Neighborhood Growth
                        </h3>
                        <p class="text-gray-600 text-sm">
                            As your network circle picks up, rewards benefit all
                            levels leading to true value for everyone at your
                            home.
                        </p>
                    </div>
                </div>

                <!-- Tier 1 -->
                <div
                    class="bg-white p-6 rounded-2xl shadow-sm border border-teal-100 flex gap-4 items-start relative overflow-hidden group hover:shadow-md transition-shadow"
                >
                    <div class="flex-1">
                        <span
                            class="text-xs font-bold text-teal-500 uppercase tracking-widest mb-1 block"
                            >Tier 1</span
                        >
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Your Direct Referrals
                        </h3>
                        <p class="text-gray-600 text-sm">
                            When you refer people new people, you will earn from
                            their work immediately.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Illustration -->
            <div class="flex justify-center md:justify-end">
                <div class="relative w-64 h-64 md:w-full md:h-96">
                    <svg
                        viewBox="0 0 200 200"
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-full h-full text-teal-800"
                    >
                        <!-- Wheelbarrow Man Illustration Placeholder -->
                        <path
                            d="M50 150 L80 150 L90 120 L60 120 Z"
                            fill="#2C7A7B"></path>
                        <!-- Legs -->
                        <rect
                            x="60"
                            y="80"
                            width="30"
                            height="50"
                            fill="#319795"></rect>
                        <!-- Body -->
                        <circle cx="75" cy="70" r="10" fill="#234E52"></circle>
                        <!-- Head -->
                        <path
                            d="M100 130 L160 130 L140 160 L110 160 Z"
                            fill="#38B2AC"
                            opacity="0.6"></path>
                        <!-- Wheelbarrow -->
                        <circle cx="125" cy="160" r="15" fill="#2C7A7B"
                        ></circle>
                        <!-- Wheel -->
                        <path
                            d="M160 120 Q170 100 180 120"
                            stroke="#319795"
                            stroke-width="2"
                            fill="none"></path>
                        <!-- Plant -->
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Why it matters -->
    <div class="text-center space-y-12">
        <div>
            <h2 class="text-3xl md:text-4xl font-bold text-teal-900 mb-4">
                Why this change matters?
            </h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
                Connects you with trusted providers who save more in
                high-density areas — and pass those savings to you.
            </p>
        </div>

        <div class="grid md:grid-cols-1 gap-4 max-w-xl mx-auto">
            <div
                class="bg-teal-50 border border-teal-100 p-6 rounded-2xl text-left hover:bg-teal-100 transition-colors cursor-default"
            >
                <p class="text-teal-900 font-semibold text-lg">
                    You earn recurring rewards
                </p>
            </div>
            <div
                class="bg-teal-50 border border-teal-100 p-6 rounded-2xl text-left hover:bg-teal-100 transition-colors cursor-default"
            >
                <p class="text-gray-700 text-lg">
                    Costs decrease for the whole neighborhood
                </p>
            </div>
            <div
                class="bg-teal-50 border border-teal-100 p-6 rounded-2xl text-left hover:bg-teal-100 transition-colors cursor-default"
            >
                <p class="text-gray-700 text-lg">
                    Providers operate more efficiently, so service improves
                </p>
            </div>
        </div>

        <div>
            <button
                class="bg-teal-500 text-white px-10 py-4 rounded-full font-bold text-lg hover:bg-teal-600 transition-colors shadow-lg shadow-teal-200"
            >
                Sign Up →
            </button>
        </div>
    </div>
</section>
