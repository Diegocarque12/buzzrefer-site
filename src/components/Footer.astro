---

---

<footer class="bg-gray-50 pt-12 md:pt-0">
  <!-- Top padding for spacing on gray background if needed, or margin-top on footer. Using margin-top on footer to pull it up if needed, or just standard flow. -->
  <div
    class="bg-[#023B3B] text-white rounded-t-3xl md:rounded-3xl mx-0 md:mx-6 px-8 py-12 md:px-12 md:py-16 relative overflow-hidden"
  >
    <!-- Up Arrow (Desktop: Bottom Right, Mobile: Top Right) -->
    <div class="absolute top-8 right-8 md:hidden">
      <a
        href="#"
        class="text-white hover:text-teal-200 transition-colors block p-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
      </a>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto flex flex-col justify-between h-full">
      <!-- Top Row: Logo (Left) & Contact/Follow (Right) -->
      <div
        class="flex flex-col md:flex-row justify-between items-start gap-12 w-full"
      >
        <!-- Logo -->
        <div class="w-full md:w-auto flex justify-center md:justify-start">
          <div class="flex items-center gap-2">
            <img
              src="/buzzrefer.svg"
              class="h-10 w-auto"
              alt="BuzzRefer Logo"
            />
            <span
              class="font-montserrat text-3xl font-extrabold text-white tracking-tight flex items-baseline"
            >
              buzz<span class="font-normal text-white">refer.</span>
            </span>
          </div>
        </div>

        <!-- Contact & Follow Columns -->
        <div
          class="flex flex-col md:flex-row gap-12 md:gap-32 w-full md:w-auto items-center md:items-start text-center md:text-left"
        >
          <!-- Contact -->
          <div class="space-y-4">
            <h4 class="text-sm text-teal-100/70 font-medium">Contact us</h4>
            <div class="space-y-2 text-lg font-light text-white">
              <p>+1 891 989–11–91</p>
              <p>hello@logoipsum.com</p>
            </div>
          </div>

          <!-- Follow -->
          <div class="space-y-4">
            <h4 class="text-sm text-teal-100/70 font-medium">Follow us</h4>
            <div class="space-y-2 text-lg font-light text-white">
              <p>Whatsapp</p>
              <p>Instagram</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Middle Row: Nav (Left) - Address (Center) - Arrow (Right) -->
      <div
        class="flex flex-col md:flex-row justify-between items-center mt-12 md:mt-32 w-full relative"
      >
        <!-- Nav Links -->
        <div
          class="flex flex-wrap justify-center md:justify-start gap-6 md:gap-8 text-lg font-medium order-2 md:order-1"
        >
          <a href="/" class="hover:text-teal-200 transition-colors">Home</a>
          <a href="/how-it-works" class="hover:text-teal-200 transition-colors"
            >How It Works</a
          >
          <a href="/contact" class="hover:text-teal-200 transition-colors"
            >Contact</a
          >
        </div>

        <!-- Address -->
        <div
          class="text-lg font-light md:absolute md:left-1/2 md:-translate-x-1/2 order-1 md:order-2 mb-8 md:mb-0"
        >
          Phoenix, Arizona, USA.
        </div>

        <!-- Desktop Arrow -->
        <div class="hidden md:block order-3">
          <a
            href="#"
            class="text-white hover:text-teal-200 transition-colors block p-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (Outside the rounded container? Or inside? Image shows inside but full width. 
       Actually image shows rounded corners at TOP only maybe? Or it's a card. 
       Let's put it inside but full width at bottom) 
  -->
  <div
    class="bg-[#00D1B2] text-[#002222] py-4 text-xs md:text-sm font-bold mt-0"
  >
    <div
      class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-3 gap-2 text-center md:text-left"
    >
      <div class="md:text-left order-2 md:order-1">
        <p>© 2025 — Copyright</p>
      </div>
      <div class="md:text-center order-1 md:order-2">
        <p>Privacy</p>
      </div>
      <div class="md:text-right order-3">
        <p>All rights reserved</p>
      </div>
    </div>
  </div>
</footer>
