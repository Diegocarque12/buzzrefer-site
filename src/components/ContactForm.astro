---

---

<section class="max-w-6xl mx-auto px-6 md:px-12 py-12 md:py-24">
  <div class="bg-teal-100/50 rounded-3xl p-8 md:p-12">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Left: Info -->
      <div class="space-y-8">
        <div>
          <p
            class="text-xs uppercase tracking-wider text-teal-700 font-bold mb-2"
          >
            CONTACT US
          </p>
          <h2
            class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6 leading-tight"
          >
            Get in touch today
          </h2>

          <p class="text-base text-gray-600 max-w-sm leading-relaxed">
            Lorem ipsum dolor sit amet consectetur adipiscing elit nulla
            adipiscing tincidunt interdum tellus du.
          </p>
        </div>

        <div class="space-y-6 pt-4">
          <div>
            <p class="text-gray-900 text-sm flex items-center gap-4">
              <span class="w-6 flex justify-center"
                ><svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-gray-700"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path></svg
                ></span
              >
              contact@company.com
            </p>
          </div>
          <div>
            <p class="text-gray-900 text-sm flex items-center gap-4">
              <span class="w-6 flex justify-center"
                ><svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-gray-700"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path></svg
                ></span
              >
              (123) 456 – 789
            </p>
          </div>
          <div>
            <p class="text-gray-900 text-sm flex items-start gap-4">
              <span class="w-6 flex justify-center mt-0.5"
                ><svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 text-gray-700"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
                ></span
              >
              <span>794 Mcallister St<br />San Francisco, 94102</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Form -->
      <form class="space-y-6">
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1"
            >Full Name*</label
          >
          <input
            type="text"
            placeholder="Abigail Rojas"
            class="w-full border-b border-gray-400 px-0 py-2 text-sm focus:outline-none focus:border-teal-900 bg-transparent placeholder-gray-500"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1"
              >Email*</label
            >
            <input
              type="email"
              placeholder="Enter your email address"
              class="w-full border-b border-gray-400 px-0 py-2 text-sm focus:outline-none focus:border-teal-900 bg-transparent placeholder-gray-500"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1"
              >Subject</label
            >
            <input
              type="text"
              placeholder="Enter the Subject"
              class="w-full border-b border-gray-400 px-0 py-2 text-sm focus:outline-none focus:border-teal-900 bg-transparent placeholder-gray-500"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1"
            >Number</label
          >
          <input
            type="tel"
            placeholder="(123) 456 - 789"
            class="w-full border-b border-gray-400 px-0 py-2 text-sm focus:outline-none focus:border-teal-900 bg-transparent placeholder-gray-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1"
            >Message*</label
          >
          <textarea
            rows="4"
            placeholder="Please type your message here..."
            class="w-full border-b border-gray-400 px-0 py-2 text-sm focus:outline-none focus:border-teal-900 bg-transparent resize-none placeholder-gray-500"
          ></textarea>
        </div>

        <div class="pt-2">
          <button
            type="submit"
            class="bg-teal-900 text-white px-8 py-3 rounded-md text-sm font-semibold hover:bg-teal-800 transition-colors shadow-lg flex items-center gap-2"
          >
            Submit
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
