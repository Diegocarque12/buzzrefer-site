---
import ArrowRightIcon from "@/components/icons/ArrowRight.astro";
---

<section class="max-w-5xl mx-auto px-6 md:px-12 py-12">
  <div
    class="bg-[#BCE9E3CC] border border-teal-main rounded-3xl p-8 md:p-12 text-left md:text-left shadow-sm"
  >
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-4xl font-bold text-teal-900 mb-4">
        A Smarter Way to <br />Access Local Services
      </h2>
      <p class="text-teal-700 mb-4 max-w-2xl font-normal text-sm md:text-base">
        Connect you with trusted service providers in high-density areas - and
        keep those dollars local to you.
      </p>

      <div class="flex flex-col gap-2 mb-8 items-start">
        <div
          class="px-4 py-0.5 rounded-full border border-teal-500 text-teal-800 bg-white shadow-sm text-sm font-medium"
        >
          Lower service rates faster
        </div>
        <div
          class="px-4 py-0.5 rounded-full border border-teal-500 text-teal-800 bg-white shadow-sm text-sm font-medium"
        >
          More reliable scheduling
        </div>
        <div
          class="px-4 py-0.5 rounded-full border border-teal-500 text-teal-800 bg-white shadow-sm text-sm font-medium"
        >
          Rewards for every person you refer
        </div>
      </div>

      <div class="flex flex-col md:flex-row gap-4">
        <a
          href="#"
          class="bg-white font-bold hover:bg-teal-dark border border-teal-main justify-center text-teal-dark hover:text-teal-main px-8 py-3 rounded-md transition-colors inline-flex items-center gap-2"
        >
          Learn more
        </a>
        <a
          href="#"
          class="bg-teal-main font-bold hover:bg-teal-dark justify-center text-teal-dark hover:text-teal-main px-8 py-3 rounded-md transition-colors inline-flex items-center gap-2"
        >
          Sign Up
          <ArrowRightIcon class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</section>
