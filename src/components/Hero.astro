---
import { Image } from "astro:assets";
import ArrowRightIcon from "@/components/icons/ArrowRight.astro";
import coinsIllustration from "@/assets/coins-illustration.svg";
---

<section
  class="relative max-w-360 mx-auto px-4 md:px-12 py-12 md:py-24 flex items-center justify-center overflow-hidden pb-64"
>
  <!-- Main Illustration (Behind) -->
  <div
    class="absolute inset-0 flex items-center justify-center -z-10 pointer-events-none -bottom-64"
  >
    <div
      class="w-full max-w-2xl aspect-square flex items-center justify-center"
    >
      <Image
        src={coinsIllustration}
        alt="Hero Background"
        class="w-full h-full object-contain"
      />
    </div>
  </div>

  <!-- Content (Foreground) -->
  <div class="relative z-10 text-center max-w-3xl mx-auto">
    <h1
      class="text-4xl md:text-6xl font-bold text-teal-dark leading-none mb-6 tracking-[-0.01em]"
    >
      Your Community. <br />
      <span class="font-normal">Better Prices.</span>
      Monthly Rewards.
    </h1>

    <p
      class="text-gray-600 text-lg md:text-2xl font-normal leading-relaxed mb-8 max-w-lg mx-auto tracking-[-0.01em]"
    >
      BuzzRefer helps you save by boosting service density in your neighborhood
      invite others and earn monthly credits automatically.
    </p>

    <a
      href="#"
      class="bg-teal-main font-bold hover:bg-teal-dark text-teal-dark hover:text-teal-main px-8 py-3 rounded-md transition-colors inline-flex items-center gap-2"
    >
      Get Started
      <ArrowRightIcon class="w-4 h-4" />
    </a>
  </div>
</section>
